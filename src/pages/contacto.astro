---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="w-full">
		<!-- Hero Section -->
		<section class="w-full relative" style="height: 60svh;">
			<img
				src="/bandido_jeans/bandido1.jpg"
				alt="Contáctanos"
				loading="eager"
				decoding="async"
				class="w-full h-full object-cover brightness-50"
			/>
			<div class="absolute inset-0 flex items-center justify-center px-4">
				<h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white text-center drop-shadow-2xl">
					Contáctanos
				</h1>
			</div>
		</section>

		<!-- Contact Section -->
		<section class="w-full py-20 px-4 sm:px-8 md:px-12">
			<div class="max-w-7xl mx-auto">
				<div class="grid md:grid-cols-2 gap-12 mb-16">
					<!-- Contact Form -->
					<div>
						<h2 class="text-3xl sm:text-4xl font-bold mb-8">Envíanos un Mensaje</h2>
						<form class="space-y-6">
							<div>
								<label for="name" class="block text-sm font-semibold mb-2">Nombre</label>
								<input
									type="text"
									id="name"
									name="name"
									required
									class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-black"
									placeholder="Tu nombre"
								/>
							</div>
							<div>
								<label for="email" class="block text-sm font-semibold mb-2">Email</label>
								<input
									type="email"
									id="email"
									name="email"
									required
									class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-black"
									placeholder="tu@email.com"
								/>
							</div>
							<div>
								<label for="phone" class="block text-sm font-semibold mb-2">Teléfono</label>
								<input
									type="tel"
									id="phone"
									name="phone"
									class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-black"
									placeholder="+51 999 999 999"
								/>
							</div>
							<div>
								<label for="message" class="block text-sm font-semibold mb-2">Mensaje</label>
								<textarea
									id="message"
									name="message"
									rows="5"
									required
									class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-black resize-none"
									placeholder="Tu mensaje aquí..."
								></textarea>
							</div>
							<button
								type="submit"
								class="w-full px-8 py-3 bg-black text-white text-sm tracking-[0.2em] font-bold hover:bg-gray-800 transition-all duration-300 rounded-lg"
							>
								ENVIAR
							</button>
						</form>
					</div>

					<!-- Contact Info -->
					<div>
						<h2 class="text-3xl sm:text-4xl font-bold mb-8">Información de Contacto</h2>
						<div class="space-y-8">
							<!-- Email -->
							<div class="flex gap-4">
								<div class="flex-shrink-0">
									<svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
									</svg>
								</div>
								<div>
									<h3 class="font-semibold text-lg">Email</h3>
									<a href="mailto:contacto@bandidojeans.com" class="text-gray-600 hover:text-black transition">
										contacto@bandidojeans.com
									</a>
								</div>
							</div>

							<!-- Phone -->
							<div class="flex gap-4">
								<div class="flex-shrink-0">
									<svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 00.948.684l1.498 4.493a1 1 0 00.502.609l2.01 1.242a1 1 0 001.187-.202l4.418-4.418a2 2 0 012.826 0l1.414 1.414a2 2 0 010 2.826l-4.418 4.418a1 1 0 00-.2 1.187l1.242 2.01a1 1 0 00.609.502l4.493 1.498a1 1 0 00.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
									</svg>
								</div>
								<div>
									<h3 class="font-semibold text-lg">Teléfono</h3>
									<a href="tel:+51999999999" class="text-gray-600 hover:text-black transition">
										+51 999 999 999
									</a>
								</div>
							</div>

							<!-- Location -->
							<div class="flex gap-4">
								<div class="flex-shrink-0">
									<svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
									</svg>
								</div>
								<div>
									<h3 class="font-semibold text-lg">Ubicación</h3>
									<p class="text-gray-600">Lima, Perú</p>
								</div>
							</div>

							<!-- Hours -->
							<div class="flex gap-4">
								<div class="flex-shrink-0">
									<svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 2m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
									</svg>
								</div>
								<div>
									<h3 class="font-semibold text-lg">Horario</h3>
									<p class="text-gray-600">Lunes a Viernes: 9:00 AM - 6:00 PM</p>
									<p class="text-gray-600">Sábados: 10:00 AM - 4:00 PM</p>
								</div>
							</div>

							<!-- Social Media -->
							<div class="pt-4 border-t border-gray-300">
								<h3 class="font-semibold text-lg mb-4">Síguenos en Redes Sociales</h3>
								<div class="flex gap-4">
									<a href="https://instagram.com" target="_blank" rel="noreferrer" class="p-3 bg-black rounded-full text-white hover:bg-gray-800 transition">
										<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
											<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.266.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm4.965-10.322a1.44 1.44 0 110-2.881 1.44 1.44 0 010 2.881z" />
										</svg>
									</a>
									<a href="https://facebook.com" target="_blank" rel="noreferrer" class="p-3 bg-black rounded-full text-white hover:bg-gray-800 transition">
										<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
											<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
										</svg>
									</a>
									<a href="https://twitter.com" target="_blank" rel="noreferrer" class="p-3 bg-black rounded-full text-white hover:bg-gray-800 transition">
										<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
											<path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z" />
										</svg>
									</a>
									<a href="https://wa.me/51999999999" target="_blank" rel="noreferrer" class="p-3 bg-black rounded-full text-white hover:bg-gray-800 transition">
										<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
											<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-9.746 9.798c0 2.719.738 5.38 2.137 7.712l-2.262 8.258a.987.987 0 001.271 1.21l8.113-2.67a9.844 9.844 0 004.787 1.214h.005C19.164 21.924 24 17.159 24 11.233c0-5.336-4.639-9.67-10.359-9.67" />
										</svg>
									</a>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Map Section -->
				<div class="mt-16">
					<h2 class="text-3xl sm:text-4xl font-bold mb-8 text-center">Ubicación</h2>
					<div class="w-full h-96 rounded-lg overflow-hidden shadow-lg">
						<iframe
							src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3901.823125145063!2d-77.04169!3d-12.0463!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9105c8c8c8c8c8c9%3A0x0!2sLima%2C%20Per%C3%BA!5e0!3m2!1ses!2spe!4v1234567890"
							width="100%"
							height="100%"
							style="border:0;"
							allowfullscreen=""
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
						></iframe>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>
