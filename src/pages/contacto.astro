---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="w-full">
		<!-- Hero Section -->
		<section class="w-full relative" style="height: 60svh; min-height: 400px;">
			<img
				src="/bandido_jeans/back2.avif"
				alt="Contáctanos"
				loading="eager"
				decoding="async"
				class="w-full h-full object-cover brightness-40"
			/>
			<div class="absolute inset-0 flex flex-col items-center justify-center px-4 sm:px-6 md:px-8">
				<h1 class="text-4xl xs:text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold text-white text-center drop-shadow-2xl mb-4 sm:mb-6 tracking-wider">
					CONTÁCTANOS
				</h1>
				<p class="text-lg xs:text-xl sm:text-2xl md:text-3xl text-white drop-shadow-lg font-semibold">Estamos aquí para ayudarte</p>
			</div>
		</section>

		<!-- Contact Section -->
		<section class="w-full py-12 sm:py-16 md:py-20 px-4 sm:px-8 md:px-12 bg-gradient-to-b from-white via-gray-50 to-gray-100 border-t-4 ">
			<div class="max-w-7xl mx-auto">
				<div class="grid md:grid-cols-2 gap-8 sm:gap-12 md:gap-16 mb-12 sm:mb-16 md:mb-20">
					<!-- Contact Form -->
					<div class="bg-white p-6 sm:p-8 md:p-12 rounded-xl shadow-lg border-l-4">
						<h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-6 sm:mb-8 text-black">Envíanos un Mensaje</h2>
						<form class="space-y-6">
							<div>
								<label for="name" class="block text-sm font-semibold mb-3 text-gray-700">Nombre</label>
								<input
									type="text"
									id="name"
									name="name"
									required
									class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent transition"
									placeholder="Tu nombre"
								/>
							</div>
							<div>
								<label for="email" class="block text-sm font-semibold mb-3 text-gray-700">Email</label>
								<input
									type="email"
									id="email"
									name="email"
									required
									class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent transition"
									placeholder="tu@email.com"
								/>
							</div>
							<div>
								<label for="phone" class="block text-sm font-semibold mb-3 text-gray-700">Teléfono</label>
								<input
									type="tel"
									id="phone"
									name="phone"
									class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent transition"
									placeholder="+51 999 999 999"
								/>
							</div>
							<div>
								<label for="message" class="block text-sm font-semibold mb-3 text-gray-700">Mensaje</label>
								<textarea
									id="message"
									name="message"
									rows="5"
									required
									class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent transition resize-none"
									placeholder="Tu mensaje aquí..."
								></textarea>
							</div>
							<button
								type="submit"
								class="w-full px-8 py-4 bg-red-600 text-white text-sm tracking-[0.2em] font-bold hover:bg-red-700 transition-all duration-300 rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
							>
								ENVIAR MENSAJE
							</button>
						</form>
					</div>

					<!-- Contact Info -->
					<div>
						<h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-6 sm:mb-8 text-black">Información de Contacto</h2>
						<div class="space-y-8">
							<!-- Email -->
							<div class="flex gap-4">
								<div class="flex-shrink-0">
									<svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
									</svg>
								</div>
								<div>
									<h3 class="font-semibold text-lg">Email</h3>
									<a href="mailto:contacto@bandidojeans.com" class="text-gray-600 hover:text-black transition">
										Raulhy@hotmail.com
									</a>
								</div>
							</div>

							<!-- Phone -->
							<div class="flex gap-4">
								<div class="flex-shrink-0">
									<svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
									</svg>
								</div>
								<div>
									<h3 class="font-semibold text-lg">Teléfono</h3>
									<a href="tel:+51959515719" class="text-gray-600 hover:text-black transition">
										+51 959 515 719
									</a>
								</div>
							</div>

							<!-- Location -->
							<div class="flex gap-4">
								<div class="flex-shrink-0">
									<svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
									</svg>
								</div>
								<div>
									<h3 class="font-semibold text-lg">Ubicación</h3>
									<p class="text-gray-600">Lima, Perú</p>
								</div>
							</div>

							<!-- Hours -->
							<div class="flex gap-4">
								<div class="flex-shrink-0">
									<svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 2m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
									</svg>
								</div>
								<div>
									<h3 class="font-semibold text-lg">Horario</h3>
									<p class="text-gray-600">Lunes a Viernes: 9:00 AM - 6:00 PM</p>
									<p class="text-gray-600">Sábados: 10:00 AM - 4:00 PM</p>
								</div>
							</div>

							<!-- Social Media -->
							<div class="pt-4 border-t border-gray-300">
								<h3 class="font-semibold text-lg mb-4">Síguenos en Redes Sociales</h3>
								<div class="flex gap-4">
								<a href="https://www.facebook.com/people/Bandido-Jeans/61573909330092/#" target="_blank" rel="noreferrer" class="p-3 bg-red-600 rounded-full text-white hover:bg-red-700 transition transform hover:scale-110">
									<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
										<path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5c-.563-.074-1.823-.177-3.456-.177-3.559 0-6.142 2.225-6.142 6.513v2.267z"/>
									</svg>
								</a>
								<a href="https://wa.me/51959515719" target="_blank" rel="noreferrer" class="p-3 bg-red-600 rounded-full text-white hover:bg-red-700 transition transform hover:scale-110">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-6 h-6" fill="currentColor" aria-hidden="true">
										<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
									</svg>
								</a>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Map Section -->
				<div class="mt-12 sm:mt-16">
					<h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-6 sm:mb-8 text-center text-black">Ubicación</h2>
					<div class="w-full h-72 sm:h-96 md:h-[500px] rounded-xl overflow-hidden shadow-2xl border-2 border-red-200">
						<iframe
							src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3913.5833628384506!2d-71.5363!3d-16.3943!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x91424b4c1c1c1c1d%3A0x82c8b5e5c5c5c5c5!2sCalle%20San%20Camilo%20308%2C%20Tienda%201A%2C%20Cercado%2C%20Arequipa%2004011!5e0!3m2!1ses!2spe!4v1704456000000"
							width="100%"
							height="100%"
							style="border:0;"
							allowfullscreen=""
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
						></iframe>
					</div>
				</div>
			</div>
		</section>

	</main>
</Layout>
