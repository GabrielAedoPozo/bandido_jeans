---
import { gsap } from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";
---

<section class="jean-section">
  <img
    src="/bandido_jeans/niño2.png"
    id="jean"
    alt="Bandido Jeans"
  />

  <h2 id="bandido-text">BANDIDO JEANS</h2>

  <div class="info-top">
    <img src="/bandido_jeans/bandido.png" alt="Bandido" class="logo" />
    <p class="hero-phrase italic">"Hecho de denim que no se rinde."</p>
  </div>
</section>

<style>
  .jean-section {
    height: 100vh;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    background: #ffffff;
    color: #0b1224;
  }

  .info-top {
    position: absolute;
    top: clamp(1.2rem, 4vw, 2.5rem);
    left: 50%;
    transform: translateX(-50%);
    width: min(920px, 92vw);
    text-align: center;
    color: #0b1224;
    opacity: 0;
    transform-origin: center;
    display: grid;
    gap: 0.6rem;
  }

  #jean {
    width: 300px;
    max-width: 80vw;
    z-index: 2;
    filter: drop-shadow(0 25px 45px rgba(0,0,0,.3));
  }

  #bandido-text {
    position: absolute;
    bottom: 12%;
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 900;
    letter-spacing: 0.08em;
    opacity: 0;
    transform: translateY(40px);
    pointer-events: none;
    color: #0b1224;
    text-shadow: 0 6px 30px rgba(0,0,0,.18);
  }

  .italic {
    font-family: "Playfair Display", "Times New Roman", Georgia, serif;
    font-style: italic;
    letter-spacing: 0.01em;
  }

  .logo {
    height: clamp(58px, 10vw, 92px);
    margin: 0 auto;
    object-fit: contain;
  }

  .hero-phrase {
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    color: #0b1224;
    line-height: 1.2;
  }

  @media (max-width: 768px) {
    #jean {
      width: 250px;
    }

    #bandido-text {
      bottom: auto;
      top: 15%;
      font-size: clamp(2rem, 8vw, 4rem);
      transform: translateY(-40px);
    }
  }

  @media (max-width: 480px) {
    #jean {
      width: 200px;
    }

    #bandido-text {
      display: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // TIMELINE ÚNICA (CLAVE)
  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: ".jean-section",
      start: "top top",
      end: "+=700",
      scrub: 1,
      pin: true,
      anticipatePin: 1
    }
  });

  // 1️⃣ Jean cae y rota (fluido)
  tl.fromTo(
    "#jean",
    {
      y: -300,
      rotation: -12
    },
    {
      y: 180,
      rotation: 12,
      ease: "none"
    }
  );

  // 2️⃣ Texto aparece SOLO AL FINAL
  tl.to(
    "#bandido-text",
    {
      opacity: 1,
      y: 0,
      ease: "power2.out",
      duration: 0.25
    },
    ">-=0.05" // aparece justo cuando termina el jean
  );

  // 3️⃣ Texto superior aparece
  tl.to(
    ".info-top",
    {
      opacity: 1,
      y: 0,
      ease: "power2.out",
      duration: 0.35
    },
    "<+0.08"
  );
</script>
