<main id="inicio" class="w-full" style="padding-top: var(--header-h, 0px);">
	<section class="w-full" style="height: calc(100svh - var(--header-h, 0px));">
		<img
			src="/bandido_jeans/bandido1.jpg"
			alt="Bandido Jeans"
			loading="eager"
			decoding="async"
			class="w-full h-full object-cover"
		/>
	</section>
	
	<div class="flex flex-none justify-center gap-10 pt-10">

		<div class="relative">
			<img src="/bandido_jeans/jeans5.webp" class="brightness-50" alt="">
			<div class="absolute inset-0 flex flex-col items-center justify-center gap-6 text-white">
				<h3 class="text-2xl font-semibold">Estilo Urbano</h3>
				<button class="px-6 py-2 border-2 border-white  text-sm font-semibold hover:bg-white hover:text-black transition-colors">
					VER MÁS
				</button>
			</div>
		</div>

		<div class="relative">
			<img src="/bandido_jeans/jeans6.avif" class="brightness-50" alt="">
			<div class="absolute inset-0 flex flex-col items-center justify-center gap-6 text-white">
				<h3 class="text-2xl font-semibold">Tendencia Actual</h3>
				<button class="px-6 py-2 border-2 border-white  text-sm font-semibold hover:bg-white hover:text-black transition-colors">
					VER MÁS
				</button>
			</div>
		</div>

	</div>

	<!-- Banner full width -->
	<div class="relative w-full h-64 sm:h-80 md:h-96 mt-10">
		<img src="/bandido_jeans/jeans.avif" alt="" class="w-full h-full object-cover brightness-50">
		<div class="absolute inset-0 flex items-center justify-center">
			<h2 class="text-white text-3xl sm:text-4xl md:text-5xl font-bold">Prueba algo diferente.</h2>
		</div>
	</div>
</main>